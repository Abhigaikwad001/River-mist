generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  reviews      Review[]
  quotes       WeddingQuote[]
}

model Package {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  description    String
  experienceType EventType
  image          String?
  priceAdult     Int       @default(0)
  priceChild     Int       @default(0)
  minGuests      Int       @default(1)
  maxGuests      Int?
  active         Boolean   @default(true)
  seasonalActive Boolean   @default(false)
  validFrom      DateTime?
  validUntil     DateTime?
  inclusions     String[]  @default([])
  displayOrder   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  mediaId        Int?
  media          Media?    @relation(fields: [mediaId], references: [id])
  bookings       Booking[]
}

model Activity {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  image             String?
  price             Int               @default(0)
  pricingType       String            @default("PER_PERSON")
  capacity          Int?
  category          String?           @default("GENERAL")
  location          String?
  active            Boolean           @default(true)
  displayOrder      Int               @default(0)
  mediaId           Int?
  media             Media?            @relation(fields: [mediaId], references: [id])
  bookingActivities BookingActivity[]
}

model Event {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  image        String?
  eventDate    DateTime
  startTime    String?
  endTime      String?
  location     String?
  capacity     Int?
  price        Int      @default(0)
  status       String   @default("PUBLISHED")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  mediaId      Int?
  media        Media?   @relation(fields: [mediaId], references: [id])
}


model MenuItem {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  image         String?
  meal          String
  category      String   @default("THALI")
  tags          String[] @default([])
  isVeg         Boolean  @default(true)
  isSeasonal    Boolean  @default(false)
  seasonalBadge String?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  mediaId       Int?
  media         Media?   @relation(fields: [mediaId], references: [id])
}

model Resource {
  id               Int               @id @default(autoincrement())
  name             String
  type             String
  capacity         Int
  description      String?
  active           Boolean           @default(true)
  bookingResources BookingResource[]
}

model Booking {
  id               Int               @id @default(autoincrement())
  bookingNumber    String            @unique
  date             DateTime
  type             EventType
  status           BookingStatus     @default(REQUESTED)
  userId           Int
  packageId        Int
  headCountAdult   Int               @default(1)
  headCountChild   Int               @default(0)
  subtotalAmount   Int               @default(0)
  discountCode     String?
  discountType     String?
  discountValue    Int?              @default(0)
  discountAmount   Int               @default(0)
  discountId       Int?
  totalAmount      Int               @default(0)
  advanceRequired  Int               @default(0)
  amountPaid       Int               @default(0)
  balanceAmount    Int               @default(0)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  package          Package           @relation(fields: [packageId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  discount         Discount?         @relation(fields: [discountId], references: [id])
  activities       BookingActivity[]
  resources        BookingResource[]
  payments         Payment[]
  weddingQuote     WeddingQuote?
  notificationLogs NotificationLog[]
}

model BookingActivity {
  bookingId  Int
  activityId Int
  quantity   Int      @default(1)
  activity   Activity @relation(fields: [activityId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([bookingId, activityId])
}

model BookingResource {
  bookingId  Int
  resourceId Int
  quantity   Int      @default(1)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@id([bookingId, resourceId])
}

model Payment {
  id                Int           @id @default(autoincrement())
  bookingId         Int
  amount            Int
  currency          String        @default("INR")
  method            String
  status            PaymentStatus @default(INITIATED)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  paymentDate       DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id])
}

model WeddingQuote {
  id                      Int               @id @default(autoincrement())
  quoteNumber             String            @unique
  userId                  Int
  eventDate               DateTime
  guestCount              Int
  subtotal                Int
  total                   Int
  advanceRequired         Int
  status                  QuoteStatus       @default(DRAFT)
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  bookingId               Int?              @unique
  decorationRequirements  String?
  djMusicRequirements     String?
  eventType               EventType         @default(WEDDING)
  foodRequirements        String?
  photographyRequirements String?
  specialRequirements     String?
  venueRequirements       String?
  items                   QuoteItem[]
  booking                 Booking?          @relation(fields: [bookingId], references: [id])
  user                    User              @relation(fields: [userId], references: [id])
  notificationLogs        NotificationLog[]
}

model QuoteItem {
  id          Int          @id @default(autoincrement())
  quoteId     Int
  category    String
  description String
  amount      Int
  quote       WeddingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  userId    Int?
  oldValue  String?
  newValue  String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Media {
  id           Int           @id @default(autoincrement())
  type         String        @default("IMAGE")
  url          String
  title        String?
  altText      String?
  description  String?
  category     String        @default("GALLERY")
  active       Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  displayOrder Int           @default(0)
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt @default(now())
  packages     Package[]
  activities   Activity[]
  events       Event[]
  menuItems    MenuItem[]
  siteContents SiteContent[]
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Discount {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique
  name                 String?
  description          String?
  type                 String
  value                Int
  minBookingAmount     Int?      @default(0)
  maxDiscountAmount    Int?
  perCustomerLimit     Int?      @default(1)
  applicablePackages   String[]  @default([])
  applicableActivities String[]  @default([])
  active               Boolean   @default(true)
  usageLimit           Int?
  usageCount           Int       @default(0)
  validFrom            DateTime?
  validUntil           DateTime?
  displayOrder         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt @default(now())
  bookings             Booking[]
}

model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  subtitle  String?
  content   String?
  image     String?
  category  String   @default("GENERAL")
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  mediaId   Int?
  media     Media?   @relation(fields: [mediaId], references: [id])
}

model DailyCapacityOverride {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique
  customCapacity Int?
  isClosed       Boolean  @default(false)
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  USER
  SUPER_ADMIN
  BOOKING_MANAGER
  EVENT_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
}

enum BookingStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAYMENT_PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

enum EventType {
  DAY_TOURISM
  HURDA_PARTY
  BIRTHDAY
  WEDDING
  DESTINATION_WEDDING
  ENGAGEMENT
  ANNIVERSARY
  CORPORATE_EVENT
  SCHOOL_COLLEGE_PICNIC
  FAMILY_DAY_OUT
  OTHER_EVENT
}

model NotificationLog {
  id           Int      @id @default(autoincrement())
  type         String
  recipient    String
  subject      String?
  content      String
  status       String   @default("PENDING")
  errorMessage String?
  retryCount   Int      @default(0)
  bookingId    Int?
  quoteId      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking?      @relation(fields: [bookingId], references: [id])
  quote   WeddingQuote? @relation(fields: [quoteId], references: [id])
}
