# Database Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/rivermist?schema=public

# Application Settings
PORT=3001
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=change-me

# Razorpay Payments (Required in Production)
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Third-Party Services
RESEND_API_KEY=your-resend-key

# Business Logic
TAX_RATE=0.18

# WhatsApp Business Cloud API Configuration (Meta Graph API)
# Mode: HYBRID (default, uses Cloud API when configured, wa.me fallback), CLOUD_API, CLICK_TO_CHAT
WHATSAPP_MODE=HYBRID
WHATSAPP_BUSINESS_PHONE_NUMBER=919322759343
WHATSAPP_CLOUD_API_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-id
WHATSAPP_API_VERSION=v21.0

# Optional Meta WhatsApp Approved Template Names
WHATSAPP_TEMPLATE_BOOKING_REQUEST=rivermist_booking_request
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=rivermist_booking_confirmed
WHATSAPP_TEMPLATE_PAYMENT_INSTRUCTIONS=rivermist_payment_instructions
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=rivermist_payment_received
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=rivermist_booking_cancelled
WHATSAPP_TEMPLATE_WEDDING_QUOTE=rivermist_wedding_quote_received
